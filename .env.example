# Copy to .env and fill in. .env is gitignored; this file is not.

# --- Groq (the generation model) ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TEMPERATURE=0.0

# --- Hugging Face (the embedding model) ---
# Free read token from https://huggingface.co/settings/tokens. Optional locally,
# strongly recommended on a deployed service: huggingface.co is Cloudflare-
# fronted and rate-limits anonymous downloads, so an unauthenticated cold start
# on a shared host IP can be answered with an HTTP 429 challenge page instead of
# the weights. Setting this raises the limit. The value is never logged.
# HF_TOKEN=

# Retries and base backoff for that download, in seconds. Defaults wait
# 5 + 10 + 20 s across four attempts, which outlasts the limit window in
# practice. Raise the backoff if the host is slow rather than the count.
# MODEL_LOAD_ATTEMPTS=4
# MODEL_LOAD_BACKOFF=5.0

# --- optional ---
# Embedding batch size for index builds. 8 is measured as the knee of the curve:
# 16 -> 581 MB, 8 -> 565 MB, 4 -> 536 MB, all against a 512 MB Render free
# instance, which is why the committed index is built on a developer machine
# rather than on deploy. Harmless to change if you rebuild.
# EMBED_BATCH=8

# Where the built vector index lives. Normally data/processed/vector_index,
# which is committed so a free Render instance only loads it (489 MB resident)
# instead of building it on boot (565 MB peak, killed at 512 MB). It is rebuilt
# on demand when absent or stale. Point it at a writable volume if the source
# checkout is read-only.
# INDEX_DIR=
